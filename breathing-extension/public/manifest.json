{
  "manifest_version": 3,
  "name": "Cat Wave Breathing",
  "short_name": "Cat Wave Breathing",
  "description": "A minimalist breathing coach for office workers: watch a sleeping cat's back turn into a calming wave while you inhale and exhale.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cat Wave Breathing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "sidePanel"]
}
